# Tonaris settings (TS-105). Local development needs none of them: every value below has a local default
# (TS-06). Production sets them in the host's secret store; the API refuses to start without the required ones.
# Bun reads a `.env` file from the directory a command runs in, such as apps/api for the API.

# --- tonaris-api (apps/api) ---

# Required in production. The API's and the web app's origins (TS-08). The session cookie is scoped to the web
# app's host, which must be the parent of the API's: https://tonaris.example and https://api.tonaris.example.
API_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# Required in production. Signs session cookies; at least 32 random bytes, e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=

# Required in production: one of these two. Outgoing email (TS-72) goes through Resend when its API key is set,
# and through SMTP otherwise; locally, Mailpit's SMTP port. The key needs only "Sending access" (docs/deploy.md).
# RESEND_API_KEY=
SMTP_URL=smtp://localhost:1025

# Required in production. The sender: an address on the domain verified in Resend, such as
# "Tonaris <no-reply@mail.tonaris.app>".
EMAIL_FROM="Tonaris <no-reply@tonaris.test>"

# Required in production. Where people write for help, shown on /help/recovery (TS-73): a mailbox you read, since
# someone who lost their sign-in email asks you there to move their account.
SUPPORT_EMAIL=support@tonaris.test

# Required in production. Where the revocation ledger is written (TS-113): an off-site S3-compatible bucket of its
# own, `s3://bucket/prefix`, with write-once retention if the storage has it, and S3_ACCESS_KEY_ID,
# S3_SECRET_ACCESS_KEY, S3_ENDPOINT and S3_REGION for it: in production, Cloudflare R2 with region `auto`
# (docs/deploy.md). A restore replays it. Locally it defaults to .ledger/.
# LEDGER_URL=s3://tonaris-ledger/events

# Optional. Sentry's DSN for this service's project (TS-115, docs/runbooks/monitoring.md): the API's on the API, the
# web app's on the web app. Unset, errors go to the logs only.
# SENTRY_DSN=https://…@o….ingest.sentry.io/…

# Optional. The header the host's proxy puts the client address in, for the sign-in limits (TS-104).
# Unset, the socket address is used. For X-Forwarded-For, its last entry is taken.
CLIENT_IP_HEADER=

# Optional. Port to listen on (default 3001).
# PORT=3001

# Optional. The commit this build is, which /v1/health names so the web app's deploy can wait for it (TS-01).
# Render sets RENDER_GIT_COMMIT, which is read when this is unset.
# GIT_COMMIT=

# Optional. The Spotify bridge (TS-41 step 3): a Spotify app in development mode, owned by a Premium account, with
# the Web API enabled; client credentials only. Without them, or with SPOTIFY_BRIDGE=off, Spotify links are
# identified by MusicBrainz's URL lookup alone.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# SPOTIFY_BRIDGE=off

# Required in production. The database (TS-11); tests use TEST_DATABASE_URL.
DATABASE_URL=postgres://postgres@localhost:5432/tonaris
TEST_DATABASE_URL=postgres://postgres@localhost:5432/tonaris_test

# Read by `bun run seed:creator`, which creates the creator's account once (TS-71).
CREATOR_EMAIL=

# --- tonaris-web (apps/web) ---

# Required in production. The API origin the browser calls, read when the server starts and rendered into every
# page, so one build or image serves any host.
API_URL=http://localhost:3001

# Optional. The API over the host's private network, for the server's own reads (TS-03); a bare host:port means
# plain HTTP. Unset, the server uses API_URL.
# API_INTERNAL_URL=

# Optional. Port to listen on (default 3000).
# PORT=3000

# --- tooling (run from the repository root) ---

# The G1 Spotify spike (TON-15): a Spotify app in development mode, owned by a Premium account, with the Web API
# enabled. Client credentials only; the redirect URI the dashboard requires is never used.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# The G1 YouTube Music spike (TON-128): a YouTube Data API v3 key from a Google Cloud project, restricted to that
# API (docs/spikes/2026-10-31-g1-youtube-music.md). The API will read it for YouTube Music's hints once TON-131
# builds them.
YOUTUBE_API_KEY=
