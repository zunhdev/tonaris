{
  "name": "@tonaris/api",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone Elysia API service: /v1 REST, sync stream, MCP, auth and jobs (TS-01, TS-09).",
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "build": "bun build.ts",
    "dev": "bun --watch src/index.ts",
    "openapi:check": "bun src/generate-openapi.ts --check",
    "openapi:generate": "bun src/generate-openapi.ts",
    "seed:creator": "bun src/auth/seed-creator.ts",
    "start": "bun dist/bin/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.12",
    "@better-auth/core": "1.7.12",
    "@better-auth/mcp": "1.7.12",
    "@better-auth/oauth-provider": "1.7.12",
    "@elysia/cors": "2.0.0-rc.0",
    "@elysia/openapi": "2.0.0-rc.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@sentry/bun": "11.10.0",
    "@tonaris/db": "workspace:*",
    "@tonaris/domain": "workspace:*",
    "@tonaris/providers": "workspace:*",
    "better-auth": "1.7.12",
    "elysia": "2.0.0-rc.0",
    "fflate": "0.8.3",
    "jose": "6.2.12",
    "nodemailer": "10.1.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@elysia/eden": "2.0.0-rc.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/nodemailer": "8.0.2"
  }
}
