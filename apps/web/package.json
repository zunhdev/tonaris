{
  "name": "@tonaris/web",
  "version": "0.0.0",
  "private": true,
  "description": "TanStack Start web app: UI and server-rendered public pages; all data goes through the API (TS-01, TS-03).",
  "type": "module",
  "scripts": {
    "build": "bun --bun vite build",
    "dev": "bun --bun vite dev",
    "preview": "bun --bun vite preview",
    "start": "bun server.ts",
    "test:e2e": "playwright test --project=chromium --project=pixel",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "E2E_INSECURE_COOKIES=1 playwright test --project=webkit --project=iphone",
    "test:e2e:matrix": "bun run test:e2e && bun run test:e2e:firefox && bun run test:e2e:webkit",
    "typecheck": "tsc --noEmit",
    "test:perf": "playwright test --config playwright.perf.config.ts",
    "test:verify": "playwright test --config playwright.verify.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@elysia/eden": "2.0.0-rc.1",
    "@sentry/browser": "11.11.0",
    "@simplewebauthn/browser": "13.3.0",
    "@tanstack/db": "1.0.0-rc.1.4",
    "@tanstack/react-db": "1.0.0-rc.1.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-virtual": "3.14.26",
    "@tonaris/domain": "workspace:*",
    "@tonaris/providers": "workspace:*",
    "@tonaris/ui": "workspace:*",
    "fractional-indexing": "4.0.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.4",
    "@tonaris/api": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.4",
    "vite": "8.3.7",
    "zod": "4.6.7"
  }
}
