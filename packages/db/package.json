{
  "name": "@tonaris/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, migrations and the repository implementation of the domain's transaction port (TS-02, TS-17).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "db:check": "bun src/check-migrations.ts",
    "db:create": "bun src/create-database.ts",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun src/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tonaris/domain": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.4",
    "fast-check": "4.10.2"
  }
}
