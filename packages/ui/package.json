{
  "name": "@tonaris/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design system: tokens, Base UI/shadcn primitives and shared patterns (design spec DS-10–DS-29).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "ui:add": "shadcn add -c ../../apps/web"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "shadcn": "4.22.0",
    "tailwindcss": "4.3.3"
  }
}
