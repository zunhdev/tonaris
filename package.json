{
  "name": "tonaris",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run check:workspace && bun run check:specs && bun run db:check && bun test",
    "check:specs": "openspec validate --all --strict",
    "check:workspace": "bun tooling/src/workspace-check.ts",
    "db:check": "bun run --cwd packages/db db:check",
    "db:create": "bun run --cwd packages/db db:create",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "dev": "bun run --parallel --filter './apps/*' dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "mail:test": "bun tooling/src/send-test-mail.ts",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.3",
    "@types/bun": "1.4.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.3"
}
