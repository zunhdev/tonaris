{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -z \"$CLAUDE_ENV_FILE\" || echo \"export PATH=\\\"$CLAUDE_PROJECT_DIR/node_modules/.bin:\\$PATH\\\"\" >> \"$CLAUDE_ENV_FILE\""
          }
        ]
      }
    ]
  }
}
